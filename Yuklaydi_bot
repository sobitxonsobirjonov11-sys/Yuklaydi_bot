import os
import logging
import sqlite3
import time
from typing import List, Optional, Tuple, Any

from flask import Flask, request
import telebot
from telebot import types
import yt_dlp

# ========== Konfiguratsiya ==========
BOT_TOKEN = os.getenv("BOT_TOKEN")
if not BOT_TOKEN:
    raise RuntimeError("BOT_TOKEN muhit o'zgaruvchisi aniqlanmagan!")

ADMINS = []
adm_env = os.getenv("ADMINS", "")
if adm_env:
    try:
        ADMINS = [int(x.strip()) for x in adm_env.split(",") if x.strip()]
    except Exception:
        ADMINS = []

LIMIT_STANDARD = int(os.getenv("LIMIT_STANDARD", 100 * 1024 * 1024))  # 100MB
LIMIT_VIP = int(os.getenv("LIMIT_VIP", 200 * 1024 * 1024))            # 200MB

DATABASE_PATH = os.getenv("DATABASE_PATH", "bot_base.db")
DOWNLOADS_DIR = os.getenv("DOWNLOADS_DIR", "downloads")
EXTERNAL_URL = os.getenv("RENDER_EXTERNAL_URL")  # Render beradigan URL
PORT = int(os.getenv("PORT", 5000))

os.makedirs(DOWNLOADS_DIR, exist_ok=True)

# ========== Logging ==========
logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(name)s: %(message)s")
logger = logging.getLogger("telegram-bot")

# ========== Bot va Flask ==========
bot = telebot.TeleBot(BOT_TOKEN)
app = Flask(__name__)

admin_states = {}

# ========== DB helper ==========
def get_conn() -> sqlite3.Connection:
    return sqlite3.connect(DATABASE_PATH, timeout=10, check_same_thread=False)

def init_db():
    conn = get_conn()
    try:
        cur = conn.cursor()
        cur.execute("CREATE TABLE IF NOT EXISTS users (user_id INTEGER PRIMARY KEY)")
        cur.execute("""
            CREATE TABLE IF NOT EXISTS channels (
                channel_id TEXT PRIMARY KEY,
                channel_type TEXT
            )
        """)
        conn.commit()
    finally:
        conn.close()

def add_user(user_id: int) -> None:
    conn = get_conn()
    try:
        cur = conn.cursor()
        cur.execute("INSERT OR IGNORE INTO users (user_id) VALUES (?)", (user_id,))
        conn.commit()
    finally:
        conn.close()

def get_stats() -> int:
    conn = get_conn()
    try:
        cur = conn.cursor()
        cur.execute("SELECT COUNT(*) FROM users")
        return cur.fetchone()[0]
    finally:
        conn.close()

def get_all_users() -> List[int]:
    conn = get_conn()
    try:
        cur = conn.cursor()
        cur.execute("SELECT user_id FROM users")
        return [row[0] for row in cur.fetchall()]
    finally:
        conn.close()

def add_channel_db(channel_id: str, channel_type: str) -> None:
    conn = get_conn()
    try:
        cur = conn.cursor()
        cur.execute("INSERT OR REPLACE INTO channels (channel_id, channel_type) VALUES (?, ?)", (channel_id, channel_type))
        conn.commit()
    finally:
        conn.close()

def delete_channel_db(channel_id: str) -> None:
    conn = get_conn()
    try:
        cur = conn.cursor()
        cur.execute("DELETE FROM channels WHERE channel_id = ?", (channel_id,))
        conn.commit()
    finally:
        conn.close()

def get_channels_db(channel_type: Optional[str] = None) -> List[Tuple[Any, ...]]:
    conn = get_conn()
    try:
        cur = conn.cursor()
        if channel_type:
            cur.execute("SELECT channel_id FROM channels WHERE channel_type = ?", (channel_type,))
        else:
            cur.execute("SELECT channel_id, channel_type FROM channels")
        return cur.fetchall()
    finally:
        conn.close()

init_db()

# ========== yt_dlp yordamchilari ==========
def safe_yt_opts(is_audio: bool, format_id: Optional[str] = None):
    base_out = os.path.join(DOWNLOADS_DIR, "%(id)s.%(ext)s")
    if is_audio:
        return {
            "format": "bestaudio/best",
            "outtmpl": base_out,
            "postprocessors": [{"key": "FFmpegExtractAudio", "preferredcodec": "mp3", "preferredquality": "192"}],
            "quiet": True,
            "noplaylist": True,
            "no_warnings": True,
        }
    else:
        fmt = f"bestvideo[height<={format_id}]+bestaudio/best[height<={format_id}]/best" if format_id and format_id.isdigit() else "best"
        return {
            "format": fmt,
            "outtmpl": base_out,
            "quiet": True,
            "noplaylist": True,
            "no_warnings": True,
        }

def search_music(query: str, limit: int = 10):
    opts = {"extract_flat": True, "skip_download": True, "quiet": True, "no_warnings": True}
    try:
        with yt_dlp.YoutubeDL(opts) as ydl:
            results = ydl.extract_info(f"ytsearch{limit}:{query}", download=False)
            entries = results.get("entries") or []
            tracks = []
            for e in entries:
                tracks.append({"id": e.get("id"), "title": (e.get("title") or "Noma'lum")[:60]})
            return tracks
    except Exception:
        logger.exception("search_music xatolik")
        return []

def download_media(url_or_id: str, is_audio: bool = False, format_id: Optional[str] = None) -> Tuple[str, int]:
    opts = safe_yt_opts(is_audio=is_audio, format_id=format_id)
    try:
        with yt_dlp.YoutubeDL(opts) as ydl:
            info = ydl.extract_info(url_or_id, download=True)
            filename = ydl.prepare_filename(info)
            if is_audio:
                filename = os.path.splitext(filename)[0] + ".mp3"
            size = info.get("filesize") or info.get("filesize_approx") or 0
            try:
                size = int(size)
            except Exception:
                size = 0
            return filename, size
    except Exception:
        logger.exception("download_media xatolik: %s", url_or_id)
        raise

# ========== yordamchi funktsiyalar ==========
def is_user_subscribed(user_id: int, channel_type: str = "standard") -> bool:
    channels = get_channels_db(channel_type)
    if not channels:
        return True
    for row in channels:
        ch_id = row[0]
        try:
            member = bot.get_chat_member(ch_id, user_id)
            if member.status in ["left", "kicked"]:
                return False
        except Exception:
            logger.warning("is_user_subscribed: kanalni tekshirishda xatolik: %s", ch_id)
            return False
    return True

# ========== Bot handlers ==========
@bot.message_handler(commands=["start"])
def start_cmd(message: types.Message):
    add_user(message.from_user.id)
    bot.send_message(message.chat.id, "👋 Salom! Video havola yoki musiqa nomini yuboring.")

@bot.message_handler(commands=["admin"])
def admin_cmd(message: types.Message):
    if message.from_user.id not in ADMINS:
        bot.reply_to(message, "Siz admin emassiz.")
        return
    markup = types.ReplyKeyboardMarkup(resize_keyboard=True)
    markup.add("📊 Statistika", "📢 Reklama yuborish")
    markup.add("➕ Kanal qo'shish", "🗑 Kanal o'chirish")
    markup.add("📋 Kanallar ro'yxati")
    bot.send_message(message.chat.id, "🛠 Admin panel:", reply_markup=markup)

@bot.message_handler(func=lambda msg: msg.text == "📊 Statistika")
def stats_handler(message: types.Message):
    if message.from_user.id not in ADMINS:
        return
    total = get_stats()
    bot.send_message(message.chat.id, f"📊 Jami foydalanuvchilar: {total} ta")

@bot.message_handler(func=lambda msg: msg.text == "📋 Kanallar ro'yxati")
def list_channels_handler(message: types.Message):
    if message.from_user.id not in ADMINS:
        return
    channels = get_channels_db()
    if not channels:
        bot.send_message(message.chat.id, "Hozircha kanal yo'q.")
        return
    text = "📋 Kanallar ro'yxati:\n\n"
    for ch_id, ch_type in channels:
        text += f"• `{ch_id}` — {ch_type.upper()}\n"
    bot.send_message(message.chat.id, text, parse_mode="Markdown")

