@bot.message_handler(func=lambda msg: msg.text == "📢 Reklama yuborish")
def start_broadcast(message: types.Message):
    if message.from_user.id not in ADMINS:
        return
    admin_states[message.from_user.id] = "WAITING_FOR_REKLAMA"
    bot.send_message(message.chat.id, "Reklama matnini yuboring:")

@bot.message_handler(func=lambda msg: admin_states.get(msg.from_user.id) in ["WAITING_FOR_REKLAMA", "WAITING_FOR_CHANNEL_standard", "WAITING_FOR_CHANNEL_vip"])
def handle_admin_inputs(message: types.Message):
    user_id = message.from_user.id
    state = admin_states.get(user_id)
    if state == "WAITING_FOR_REKLAMA":
        admin_states[user_id] = None
        users = get_all_users()
        success = failed = 0
        bot.send_message(message.chat.id, f"Reklama {len(users)} ta odamga yuborilmoqda...")
        for uid in users:
            try:
                bot.copy_message(chat_id=uid, from_chat_id=message.chat.id, message_id=message.message_id)
                success += 1
                time.sleep(0.05)
            except Exception:
                failed += 1
        bot.send_message(message.chat.id, f"✅ Yuborildi: {success}\n❌ Muvaffaqiyatsiz: {failed}")
    elif state and state.startswith("WAITING_FOR_CHANNEL_"):
        ch_type = state.replace("WAITING_FOR_CHANNEL_", "")
        ch_id = (message.text or "").strip()
        if not ch_id:
            bot.send_message(message.chat.id, "Iltimos kanal username'ini yuboring (masalan @kanal_username).")
            return
        add_channel_db(ch_id, ch_type)
        admin_states[user_id] = None
        bot.send_message(message.chat.id, f"✅ `{ch_id}` kanali qo'shildi!", parse_mode="Markdown")

@bot.message_handler(func=lambda msg: True, content_types=["text"])
def handle_text(message: types.Message):
    user_id = message.from_user.id
    add_user(user_id)

    if not is_user_subscribed(user_id, "standard"):
        channels = get_channels_db("standard")
        if channels:
            markup = types.InlineKeyboardMarkup()
            for row in channels:
                ch = row[0]
                link = f"https://t.me/{ch.lstrip('@')}"
                markup.add(types.InlineKeyboardButton(text="Kanalga a'zo bo'lish ➕", url=link))
            bot.send_message(message.chat.id, "Kanalga obuna bo'ling:", reply_markup=markup)
        else:
            bot.send_message(message.chat.id, "Admin kanallar ro'yxati yo'q.")
        return

    text = (message.text or "").strip()
    if text.startswith("http://") or text.startswith("https://"):
        markup = types.InlineKeyboardMarkup()
        markup.add(
            types.InlineKeyboardButton("📹 720p", callback_data=f"dl|video|720|{text}"),
            types.InlineKeyboardButton("📹 360p", callback_data=f"dl|video|360|{text}")
        )
        markup.add(types.InlineKeyboardButton("🎵 MP3", callback_data=f"dl|audio|mp3|{text}"))
        bot.send_message(message.chat.id, "Formatni tanlang:", reply_markup=markup)
    else:
        msg = bot.send_message(message.chat.id, "🔍 Qidirilmoqda...")
        try:
            tracks = search_music(text)
            if not tracks:
                bot.edit_message_text("Topilmadi 😕", message.chat.id, msg.message_id)
                return
            markup = types.InlineKeyboardMarkup()
            for t in tracks:
                markup.add(types.InlineKeyboardButton(f"🎵 {t['title']}", callback_data=f"music|{t['id']}"))
            bot.edit_message_text("Topilganlar:", message.chat.id, msg.message_id, reply_markup=markup)
        except Exception:
            logger.exception("search qatorida xatolik")
            try:
                bot.edit_message_text("Qidirishda xatolik yuz berdi", message.chat.id, msg.message_id)
            except Exception:
                bot.send_message(message.chat.id, "Qidirishda xatolik yuz berdi")

@bot.callback_query_handler(func=lambda call: True)
def callback_handler(call: types.CallbackQuery):
    user_id = call.from_user.id
    data = call.data.split("|", 3) if call.data else []
    if not data:
        bot.answer_callback_query(call.id, "Noma'lum so'rov")
        return

    if data[0] == "add_ch_type" and len(data) >= 2:
        ch_type = data[1]
        admin_states[user_id] = f"WAITING_FOR_CHANNEL_{ch_type}"
        bot.send_message(call.message.chat.id, "Kanal username'ini yuboring (masalan: `@kanal_username`)", parse_mode="Markdown")
        bot.answer_callback_query(call.id)
        return

    if data[0] == "del_ch" and len(data) >= 2:
        ch_id = data[1]
        delete_channel_db(ch_id)
        bot.send_message(call.message.chat.id, f"✅ `{ch_id}` o'chirildi!", parse_mode="Markdown")
        bot.answer_callback_query(call.id)
        return

    is_vip = is_user_subscribed(user_id, "vip")
    max_limit = LIMIT_VIP if is_vip else LIMIT_STANDARD

    try:
        if data[0] == "music" and len(data) >= 2:
            video_id = data[1]
            url = f"https://www.youtube.com/watch?v={video_id}"
            bot.answer_callback_query(call.id, "Yuklanmoqda...")
            try:
                file_path, size = download_media(url, is_audio=True)
                if size > max_limit and max_limit > 0:
                    bot.send_message(call.message.chat.id, f"⚠️ Fayl hajmi juda katta ({size // (1024*1024)} MB). Cheklov: {max_limit // (1024*1024)} MB")
                else:
                    with open(file_path, "rb") as audio:
                        bot.send_audio(call.message.chat.id, audio)
                if os.path.exists(file_path):
                    os.remove(file_path)
            except Exception:
                logger.exception("music yuklash xatosi")
                bot.send_message(call.message.chat.id, "Yuklashda xatolik yuz berdi.")
            return

        if data[0] == "dl" and len(data) >= 4:
            mode, fmt, url = data[1], data[2], data[3]
            bot.answer_callback_query(call.id, "Yuklanmoqda...")
            is_audio = (mode == "audio")
            try:
                file_path, size = download_media(url, is_audio=is_audio, format_id=(fmt if not is_audio else None))
                if size > max_limit and max_limit > 0:
                    bot.send_message(call.message.chat.id, f"⚠️ Fayl hajmi juda katta ({size // (1024*1024)} MB). Cheklov: {max_limit // (1024*1024)} MB")
                else:
                    with open(file_path, "rb") as f:
                        if is_audio:
                            bot.send_audio(call.message.chat.id, f)
                        else:
                            bot.send_video(call.message.chat.id, f)
                if os.path.exists(file_path):
                    os.remove(file_path)
            except Exception:
                logger.exception("dl yuklash xatosi")
                bot.send_message(call.message.chat.id, "Videoni yuklash imkoni bo'lmadi.")
            return

        bot.answer_callback_query(call.id, "Noma'lum tugma")
    except Exception:
        logger.exception("callback_handler umumiy xatolik")
        try:
            bot.send_message(call.message.chat.id, "Ichki xatolik yuz berdi.")
        except Exception:
            pass

# ========== Webhook & Flask endpoint ==========
@app.route(f"/{BOT_TOKEN}", methods=["POST"])
def webhook_receive():
    try:
        json_string = request.get_data().decode("utf-8")
        update = telebot.types.Update.de_json(json_string)
        bot.process_new_updates([update])
        return "OK", 200
    except Exception:
        logger.exception("webhook_receive xatolik")
        return "ERR", 500

@app.route("/", methods=["GET"])
def index():
    if EXTERNAL_URL:
        init_webhook()
        return "Bot va Webhook faol!", 200
    return "Bot faol (Polling rejimida yoqilgan)", 200

@app.route("/health", methods=["GET"])
def health():
    return "OK", 200

def init_webhook():
    if not EXTERNAL_URL:
        return False
    webhook_url = f"{EXTERNAL_URL.rstrip('/')}/{BOT_TOKEN}"
    try:
        bot.remove_webhook()
        bot.set_webhook(url=webhook_url)
        logger.info("Webhook muvaffaqiyatli o'rnatildi: %s", webhook_url)
        return True
    except Exception:
        logger.exception("Webhook o'rnatishda xatolik")
        return False

# ========== Ishga tushirish (Run) ==========
if __name__ == "__main__":
    if EXTERNAL_URL:
        init_webhook()
        app.run(host="0.0.0.0", port=PORT)
    else:
        logger.info("EXTERNAL_URL topilmadi. Bot Polling rejimida ishga tushmoqda...")
        bot.remove_webhook()
        bot.infinity_polling()
